---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services = [
  {id:'spina',name:'Классический массаж спины',detail:'Массаж спины по отдельному протоколу.',duration:'45 минут',price:'3 000 ₽'},
  {id:'sheya',name:'Классический массаж шейно-воротниковой зоны и рук',detail:'Шейно-воротниковая зона и верхние конечности по протоколу.',duration:'45–60 минут',price:'3 000 ₽'},
  {id:'poyasnitsa',name:'Классический массаж пояснично-крестцового отдела и ног',detail:'Пояснично-крестцовая область и нижние конечности; работа со стопами аппаратным способом согласно протоколу.',duration:'45–60 минут',price:'3 000 ₽'},
  {id:'telo',name:'Классический общий массаж',detail:'Спина, руки, ноги, грудь и живот по протоколу общего массажа.',duration:'1,5–2 часа',price:'5 000 ₽'}
];
---
<BaseLayout title="Прайс на классический массаж в Переделкино | Массаж Переделкино" description="Личный прайс Павла: классический массаж спины, шейно-воротниковой зоны и рук, пояснично-крестцового отдела и ног, общий массаж. Цены от 3 000 ₽.">
  <section class="page-hero"><div class="wrap"><p class="eyebrow">Личный прайс · Массаж Переделкино</p><h1>Классический массаж</h1><p>Четыре услуги классического массажа по собственным протоколам Павла. Здесь указаны его личные услуги, продолжительность сеансов и стоимость. Актуальный адрес приёма смотрите в разделе «Контакты».</p></div></section>
  <section class="section"><div class="wrap">
    {services.map((service,i)=><div class="list-row" id={service.id}>
      <span class="number">{String(i+1).padStart(2,'0')}</span>
      <div><h2>{service.name}</h2><p>{service.detail}</p><p><strong>Продолжительность: {service.duration} · Стоимость: {service.price}</strong></p></div>
      <a href="tel:+79859790879" class="button button-primary" aria-label={'Позвонить по поводу записи на услугу: '+service.name}>Позвонить для записи</a>
    </div>)}
    <p class="muted" style="margin-top: 24px">Прайс относится к личной практике Павла и не зависит от площадки, на которой проводится сеанс.</p>
  </div></section>
  <section class="section section-pale"><div class="wrap narrow"><p class="eyebrow">Перед посещением</p><h2>Сначала противопоказания</h2><p>Перед сеансом знакомим с противопоказаниями и уточняем, нет ли причин отложить массаж или предварительно обсудить его с врачом. Затем выясняем пожелания к процедуре и комфортную интенсивность.</p><a href="/protivopokazaniya/" class="text-link">Проверить противопоказания →</a><p><a href="/kontakty/" class="text-link">Контакты и адрес →</a></p></div></section>
</BaseLayout>
