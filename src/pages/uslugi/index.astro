---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services = [
  {id:'spina',name:'Классический массаж спины',text:'Оздоровительный массаж с вниманием к спине и плечевому поясу.'},
  {id:'sheya',name:'Массаж шеи и плеч',text:'Сеанс с акцентом на область шеи и плеч, в комфортной для вас интенсивности.'},
  {id:'poyasnitsa',name:'Массаж поясницы и ног',text:'Оздоровительный формат с вниманием к пояснично-крестцовой области и ногам.'},
  {id:'telo',name:'Общий массаж тела',text:'Расширенный сеанс для тех, кто хочет уделить время себе и телу целиком.'}
];
---
<BaseLayout title="Услуги классического массажа в Переделкино | Массаж Переделкино" description="Массаж спины, шеи и плеч, поясницы и ног, общий массаж в Ново-Переделкино. Уточните длительность и цены у администратора.">
  <section class="page-hero"><div class="wrap"><p class="eyebrow">Массаж Переделкино</p><h1>Услуги</h1><p>Классический и оздоровительный массаж с учётом ваших пожеланий. Актуальную стоимость, длительность и свободные часы уточните перед записью.</p></div></section>
  <section class="section"><div class="wrap">{services.map((service,i)=><div class="list-row" id={service.id}><span class="number">{String(i+1).padStart(2,'0')}</span><div><h2>{service.name}</h2><p>{service.text}</p></div><a href="tel:+79859790879" class="button button-primary">Уточнить и записаться</a></div>)}</div></section>
  <section class="section section-pale"><div class="wrap narrow"><p class="eyebrow">Перед посещением</p><h2>Выбираем формат вместе</h2><p>Если не знаете, какая услуга подойдёт, опишите ваши пожелания администратору. При острых состояниях, противопоказаниях или сомнениях в безопасности массажа следует предварительно проконсультироваться с врачом.</p><a href="/kontakty/" class="text-link">Контакты и адрес →</a></div></section>
</BaseLayout>
