---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map(post => ({params:{slug:post.id},props:{post}}));
}
const { post } = Astro.props as {post:CollectionEntry<'blog'>};
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('ru-RU',{day:'numeric',month:'long',year:'numeric'});
---
<BaseLayout title={post.data.title + ' | Массаж Переделкино'} description={post.data.description}>
  <article><section class="page-hero"><div class="wrap narrow"><a href="/blog/" class="back">← Все статьи</a><p class="eyebrow">{fmt.format(post.data.pubDate)}</p><h1>{post.data.title}</h1><p>{post.data.description}</p></div></section>
  <div class="wrap narrow article"><Content /><hr /><p class="muted">Материал носит информационный характер и не заменяет консультацию врача.</p><a class="button button-primary" href="tel:+79859790879">Уточнить запись ↗</a></div>
  </article>
</BaseLayout>
