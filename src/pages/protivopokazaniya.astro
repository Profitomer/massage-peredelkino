---
import BaseLayout from '../layouts/BaseLayout.astro';
const wiki = (title: string) => 'https://ru.wikipedia.org/wiki/' + encodeURIComponent(title.replaceAll(' ', '_'));
const sources = [
  {name:'Первоначальный список противопоказаний',url:'https://docs.google.com/document/d/1ybkCjid1hKkWJoix6WJIq7AqHrMsiUSoZL4FnW-sRpI/edit'},
  {name:'Обновлённый список противопоказаний (2026)',url:'https://docs.google.com/document/d/1YacQ-XlobZ5jgDJCdpX74z-RiRRf9MI6Qyye8ud_AJI/edit'}
];
const groups = [
 {title:'Состояния, при которых сеанс следует отложить или предварительно согласовать с врачом',intro:'Если заболевание активно, состояние ухудшается либо имеются тревожные симптомы, массаж не начинаем до выяснения безопасности.',items:[
  {label:'Высокое артериальное давление и гипертоническая болезнь',links:[['Гипертоническая болезнь','Артериальная гипертензия']],detail:'Особенно при значительном повышении давления или симптомах недомогания. При давлении около 180/120 мм рт. ст. и выше, особенно с симптомами, нужна срочная медицинская оценка.'},
  {label:'Онкологические заболевания',links:[['Злокачественные опухоли','Злокачественная опухоль']],detail:'Сам диагноз не означает пожизненного запрета на любой массаж. Безопасность, область воздействия и интенсивность согласуются с лечащим врачом.'},
  {label:'ВИЧ-инфекция и СПИД',links:[['ВИЧ-инфекция','ВИЧ-инфекция'],['СПИД','СПИД']],detail:'Сам по себе ВИЧ-статус не служит основанием для отказа. Оценивается текущее состояние, наличие инфекции, повреждений кожи и иные ограничения.'},
  {label:'Гемофилия и нарушения свёртываемости',links:[['Гемофилия','Гемофилия']],detail:'Особенно при кровоточивости, склонности к образованию гематом и на фоне лекарств, влияющих на свёртывание.'},
  {label:'Остеомиелит',links:[['Остеомиелит','Остеомиелит']],detail:'При активном воспалительном или инфекционном процессе массаж не проводится без медицинского разрешения.'},
  {label:'Острые психические состояния',links:[['Психические расстройства','Психическое расстройство']],detail:'При выраженном обострении, нарушении способности дать согласие или оценить ощущения необходимо сначала получить медицинскую помощь.'},
  {label:'Сердечная или дыхательная недостаточность',links:[['Сердечная недостаточность','Сердечная недостаточность'],['Дыхательная недостаточность','Дыхательная недостаточность']],detail:'При декомпенсации или выраженных симптомах необходима консультация врача.'},
  {label:'Активный туберкулёз',links:[['Туберкулёз','Туберкулёз']],detail:'При заразной форме или активном заболевании очный сеанс откладывается.'},
  {label:'Острые заболевания внутренних органов',links:[['Гепатит','Гепатит'],['Панкреатит','Панкреатит'],['Нефрит','Нефрит']],detail:'Особенно при острых воспалительных заболеваниях печени, поджелудочной железы и почек.'},
  {label:'Сепсис',links:[['Сепсис','Сепсис']],detail:'Тяжёлое состояние, требующее неотложной медицинской помощи, а не массажной процедуры.'}
 ]},
 {title:'Временные и местные ограничения',intro:'В некоторых случаях сеанс откладывается полностью, а иногда достаточно не воздействовать на определённый участок. Решение зависит от конкретного состояния.',items:[
  {label:'Острые инфекции и повышение температуры',links:[['ОРВИ','Острая респираторная вирусная инфекция'],['Грипп','Грипп']],detail:'При остром заболевании, лихорадке или выраженном недомогании посещение откладываем.'},
  {label:'Кровотечения и менструация',links:[['Менструация','Менструация']],detail:'При кровотечении неизвестной причины или выраженном недомогании необходима медицинская оценка. Обычная менструация сама по себе не является универсальным запретом на массаж.'},
  {label:'Воспаление лимфатических узлов',links:[['Лимфаденит','Лимфаденит']],detail:'Не массируем болезненные или воспалённые лимфоузлы; причину воспаления определяет врач.'},
  {label:'Инфекционные и воспалительные заболевания кожи',links:[['Фурункулёз','Фурункул'],['Герпес','Герпес'],['Акне','Акне']],detail:'Не воздействуем на поражённые участки; при заразных кожных инфекциях сеанс может потребоваться отложить.'},
  {label:'Повреждения и изменения кожи',links:[['Родинки','Невус'],['Папилломы','Папиллома'],['Рубцы','Рубец']],detail:'Обходим открытые раны, порезы, раздражения, свежие рубцы, чувствительные родинки и не зажившие татуировки. Срок заживления индивидуален.'},
  {label:'Беременность',links:[['Беременность','Беременность']],detail:'Это не универсальный запрет: допустимость массажа, положение тела, зоны и интенсивность зависят от течения беременности и подготовки специалиста. Рекомендуется предварительное согласование с врачом.'},
  {label:'Варикоз и тромбофлебит',links:[['Варикозное расширение вен','Варикозное расширение вен'],['Тромбофлебит','Тромбофлебит']],detail:'При подозрении на тромбоз, болезненности, отёке, покраснении или воспалении вен массаж соответствующей области не проводится, необходима медицинская оценка.'},
  {label:'Алкогольное и наркотическое опьянение',links:[['Алкогольное опьянение','Алкогольное опьянение']],detail:'Сеанс откладывается до восстановления трезвого и ясного состояния.'},
  {label:'Лекарства, влияющие на сознание',links:[],detail:'При выраженной сонливости, спутанности сознания или нарушении способности оценивать ощущения и давать согласие сеанс откладывается.'}
 ]}
];
---
<BaseLayout title="Противопоказания к классическому массажу | Массаж Переделкино" description="О чём сообщить перед классическим массажем: заболевания, временные ограничения, безопасность сеанса. Справочная информация с ссылками на Википедию.">
  <section class="page-hero"><div class="wrap narrow">
    <p class="eyebrow">Перед первым сеансом</p><h1>Противопоказания к массажу</h1>
    <p>Перед обсуждением пожеланий и началом массажа знакомимся с возможными противопоказаниями. Если у вас есть заболевания или сомнения, сообщите о них до сеанса.</p>
  </div></section>
  <section class="section"><div class="wrap narrow">
    <p><strong>Важно:</strong> это информационный список для предварительной беседы, а не средство самодиагностики и не медицинское заключение. Он составлен по рабочим документам Павла; исходные категоричные формулировки уточнены, поскольку не каждое указанное заболевание всегда и при любых обстоятельствах запрещает массаж. Википедия дана только для знакомства с терминами и не заменяет консультацию врача.</p>
    {groups.map(group => <section style="margin-top: 50px"><h2>{group.title}</h2><p class="muted">{group.intro}</p>
      {group.items.map((item,i)=><div style="padding: 22px 0; border-bottom: 1px solid var(--line)">
        <h3 style="margin-bottom: 10px">{i+1}. {item.links.length>0 ? <a href={wiki(item.links[0][1])} target="_blank" rel="noopener noreferrer" style="text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:4px" title="Открыть справку в Википедии">{item.label} ↗</a> : item.label}</h3>
        <p style="margin-bottom:8px">{item.detail}</p>
        {item.links.length>0 && <p style="font-size:.82rem;color:var(--soft);margin:0">Справка: {item.links.map(([label,slug],j)=><span>{j>0?' · ':''}<a style="text-decoration:underline;text-underline-offset:3px" href={wiki(slug)} target="_blank" rel="noopener noreferrer">{label} ↗</a></span>)}</p>}
      </div>)}
    </section>)}
    <section style="margin-top:46px"><h2>Что делать, если нашли у себя состояние из списка?</h2><p>Сообщите об этом до записи или перед сеансом. При остром заболевании, подозрении на тромбоз, выраженном повышении давления, инфекции или ухудшении самочувствия массаж следует отложить и обратиться за медицинской оценкой. О возможности процедуры при хроническом заболевании спросите лечащего врача.</p>
      <a href="tel:+79859790879" class="button button-primary">Позвонить для записи</a>
    </section>
    <p class="muted" style="margin-top:40px;font-size:.8rem">Рабочий первоисточник: «Противопоказания к массажу» (2025) и обновлённая редакция (2026) на Google Диске владельца практики. {sources.map((source,i)=><span>{i>0?' · ':''}<a href={source.url} target="_blank" rel="noopener noreferrer" style="text-decoration:underline">{source.name}</a></span>)}. Доступ к оригиналам может быть ограничен настройками Google Диска.</p>
  </div></section>
</BaseLayout>
